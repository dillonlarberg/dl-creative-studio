# cutdown-tracer — copy to .env and fill in. Never commit .env.
# The offline test suite (`npm test`) needs NONE of these — they're only for the
# verify-* smoke tests and the real-provider build-order steps (3–5).

# Gemini moment-selection (step 3). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Shotstack render — use the SANDBOX/stage key (free, watermarked).
# https://dashboard.shotstack.io → API Keys
SHOTSTACK_API_KEY=

# Seam factory switch: 1 (default) = all Fakes, no network. 0 = real providers.
USE_FAKES=1
