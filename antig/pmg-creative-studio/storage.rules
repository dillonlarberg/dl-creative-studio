rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────────
    // Email allowlist — must stay in sync with firestore.rules and
    // functions/src/_shared/allowlist.ts.
    // ─────────────────────────────────────────────────────────────────────
    // Alli SSO via OIDC issues Firebase tokens without an `email_verified`
    // claim (the upstream IdP verifies emails during the OAuth handshake
    // but Firebase's OIDC connector doesn't propagate the claim). Trust
    // the `sign_in_provider` as a proxy for OIDC IdPs we own. Direct
    // Google sign-in still needs the standard email_verified flag.
    // Mirror of functions/src/_shared/assertAlliStudioUser.ts.
    function isAlliStudioUser() {
      return request.auth != null
          && (request.auth.token.email_verified == true
              || request.auth.token.firebase.sign_in_provider == 'oidc.alli')
          && request.auth.token.email in [
               'annie.nguyen@pmg.com',
               'chris@pmg.com',
               'chris.alvares@pmg.com',
               'coralie.james@pmg.com',
               'diego.escobar@pmg.com',
               'dillon@pmg.com',
               'maxwell.thomason@pmg.com'
             ];
    }

    // Per-client membership check via custom claims set by the
    // syncClientClaims callable function. Returns false for all users
    // until that callable is deployed and invoked after Alli login.
    function isClientMember(clientSlug) {
      return request.auth.token.get('clients', {}).get(clientSlug, false) == true;
    }

    // ─────────────────────────────────────────────────────────────────────
    // Client storage subtree — explicit per-path rules replace the old catch-all.
    // Same rationale as firestore.rules: the catch-all ORs with narrower rules,
    // making templateLibrary write restrictions ineffective.
    // TODO(roles): add isClientMember(clientSlug) once syncClientClaims ships.
    // ─────────────────────────────────────────────────────────────────────

    // App uploads — all app-generated content (creatives, renders, batch output).
    match /clients/{clientSlug}/apps/{appId}/{allPaths=**} {
      allow read, write: if isAlliStudioUser();
    }

    // Template Library assets — thumbnails and uploaded field images.
    // Read mirrors Firestore draft-privacy (draft: creator only; published: all allowlisted).
    // Write: owner only — non-owners cannot upload new assets for a template they don't own.
    match /clients/{clientSlug}/templateLibrary/{templateId}/{allPaths=**} {
      allow read: if isAlliStudioUser() && (
        firestore.get(/databases/(default)/documents/clients/$(clientSlug)/templateLibrary/$(templateId)).data.status == 'published' ||
        firestore.get(/databases/(default)/documents/clients/$(clientSlug)/templateLibrary/$(templateId)).data.createdByUid == request.auth.uid
      );
      allow write: if isAlliStudioUser() &&
        firestore.get(/databases/(default)/documents/clients/$(clientSlug)/templateLibrary/$(templateId)).data.createdByUid == request.auth.uid;
    }

    // Default-deny everywhere else, including the previously-permissive
    // /uploads/{slug}/** path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
