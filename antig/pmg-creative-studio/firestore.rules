rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    // Email allowlist for Alli Studio access. Must stay in sync with
    // functions/src/_shared/allowlist.ts (asserted by the drift test in
    // functions/src/_shared/__tests__/allowlist-drift.test.ts).
    // ─────────────────────────────────────────────────────────────────────
    // Alli SSO via OIDC issues Firebase tokens without an `email_verified`
    // claim (the upstream IdP verifies emails during the OAuth handshake
    // but Firebase's OIDC connector doesn't propagate the claim). Trust
    // the `sign_in_provider` as a proxy for OIDC IdPs we own. Direct
    // Google sign-in still needs the standard email_verified flag.
    // Mirror of functions/src/_shared/assertAlliStudioUser.ts.
    function isAlliStudioUser() {
      return request.auth != null
          && (request.auth.token.email_verified == true
              || request.auth.token.firebase.sign_in_provider == 'oidc.alli')
          && request.auth.token.email in [
               'annie.nguyen@pmg.com',
               'chris@pmg.com',
               'chris.alvares@pmg.com',
               'coralie.james@pmg.com',
               'diego.escobar@pmg.com',
               'dillon@pmg.com',
               'maxwell.thomason@pmg.com'
             ];
    }

    // Per-client membership check via custom claims set by the
    // syncClientClaims callable function. Returns false for all users
    // until that callable is deployed and invoked after Alli login.
    function isClientMember(clientSlug) {
      return request.auth.token.get('clients', {}).get(clientSlug, false) == true;
    }

    // ─────────────────────────────────────────────────────────────────────
    // Client subtree — explicit per-collection rules replace the old catch-all.
    //
    // WHY: Firestore ORs all matching rules. A catch-all `/clients/{slug}/**`
    // grants isAlliStudioUser() to ALL subpaths, making it impossible to add
    // narrower rules (e.g. draft-privacy, ownership checks) for templateLibrary.
    // Each collection is now explicit.
    //
    // TODO(roles): add isClientMember(clientSlug) to each rule once
    // syncClientClaims callable is deployed.
    // ─────────────────────────────────────────────────────────────────────

    // Brand profile document — field data (name, colors, fonts) lives here.
    match /clients/{clientSlug} {
      allow read, write: if isAlliStudioUser();
    }

    // Brand assets — logos, fonts, uploaded brand media.
    match /clients/{clientSlug}/assets/{assetId} {
      allow read, write: if isAlliStudioUser();
    }

    // App subtree — creatives, templates, batches, outputs across all appIds.
    // /outputs/ subcollection is also covered by the collectionGroup rule below.
    match /clients/{clientSlug}/apps/{appId}/{document=**} {
      allow read, write: if isAlliStudioUser();
    }

    // Template Library — client-level reusable templates shared across apps.
    // Narrower than the app rules: draft privacy + ownership on create/update.
    match /clients/{clientSlug}/templateLibrary/{templateId} {

      allow read: if isAlliStudioUser() && (
        resource.data.status == 'published' ||
        resource.data.createdByUid == request.auth.uid
      );

      // Create: must start as a draft at version 1, owned by the creator.
      allow create: if isAlliStudioUser() &&
        request.resource.data.createdByUid   == request.auth.uid  &&
        request.resource.data.id             == templateId        &&
        request.resource.data.status         == 'draft'           &&
        request.resource.data.version        == 1                 &&
        request.resource.data.publishedAt    == null              &&
        request.resource.data.publishedBy    == null              &&
        request.resource.data.publishedByUid == null;

      // Draft update: creator only, immutable fields protected, status stays draft.
      allow update: if isAlliStudioUser() &&
        resource.data.status == 'draft' &&
        resource.data.createdByUid == request.auth.uid &&
        request.resource.data.id           == resource.data.id           &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdBy    == resource.data.createdBy    &&
        request.resource.data.createdAt    == resource.data.createdAt    &&
        request.resource.data.status       == 'draft';

      // Publish transition: creator only (draft → published).
      allow update: if isAlliStudioUser() &&
        resource.data.status == 'draft' &&
        resource.data.createdByUid == request.auth.uid &&
        request.resource.data.id           == resource.data.id           &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdBy    == resource.data.createdBy    &&
        request.resource.data.createdAt    == resource.data.createdAt    &&
        request.resource.data.status       == 'published';

      // Published template edit: any allowlisted user, immutable fields protected.
      // TODO(roles): narrow to isClientMember(clientSlug) && memberRole in ['admin', 'editor']
      allow update: if isAlliStudioUser() &&
        resource.data.status == 'published' &&
        request.resource.data.id           == resource.data.id           &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdBy    == resource.data.createdBy    &&
        request.resource.data.createdAt    == resource.data.createdAt    &&
        request.resource.data.status       == 'published';

      // Delete: creator only.
      allow delete: if isAlliStudioUser() &&
        resource.data.createdByUid == request.auth.uid;

      // History subcollection: immutable after write; access mirrors parent visibility.
      match /history/{historyId} {
        allow read: if isAlliStudioUser() && (
          get(/databases/$(database)/documents/clients/$(clientSlug)/templateLibrary/$(templateId)).data.status == 'published' ||
          get(/databases/$(database)/documents/clients/$(clientSlug)/templateLibrary/$(templateId)).data.createdByUid == request.auth.uid
        );
        allow create: if isAlliStudioUser() && (
          get(/databases/$(database)/documents/clients/$(clientSlug)/templateLibrary/$(templateId)).data.status == 'published' ||
          get(/databases/$(database)/documents/clients/$(clientSlug)/templateLibrary/$(templateId)).data.createdByUid == request.auth.uid
        );
        allow update, delete: if false;
      }
    }

    // Datasource registry — written ONLY by the scanDatasources Cloud Function
    // (admin SDK, bypasses rules). Apps read; there is no client write path.
    //
    // NOTE: the prototype catch-all above currently OR-grants write to
    // allowlisted users (Firestore unions allows across matching rules; a
    // second rule cannot deny what another grants). True client-write denial
    // lands when that catch-all is scoped to explicit subtrees — tracked with
    // the existing isClientMember TODO. Meanwhile no client code writes here.
    match /clients/{clientSlug}/datasources/{modelName} {
      allow read: if isAlliStudioUser();
      allow write: if false;
    }

    // collectionGroup queries on the unified `outputs` subcollection power
    // the cross-app "your generations" view. The recursive per-client rule
    // above covers per-path reads/writes but does NOT match collectionGroup
    // queries — Firestore resolves those against /{path=**}/outputs/{...}.
    // Writes are explicitly denied here so the per-client rule remains the
    // single write path. Reads are allowlist-gated for now and tighten to
    // isClientMember(resource.data.clientSlug) once syncClientClaims ships.
    match /{path=**}/outputs/{outputId} {
      allow read: if isAlliStudioUser();
      allow write: if false;
    }

    // Legacy brand-standards collection. The dashboard still reads/writes
    // `clientAssetHouse/{slug}` per the HOTFIX in
    // src/services/clientAssetHouse.ts (data was never migrated to the
    // canonical `clients/{slug}` doc). Allowlist-only until that migration
    // ships; remove this block once the service flips to paths.client(slug).
    match /clientAssetHouse/{clientSlug} {
      allow read, write: if isAlliStudioUser();
    }

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
